# Discord application token. Developer Portal → Bot → Reset Token.
DISCORD_TOKEN=

# Optional. One or more server ids (comma-separated) for instant slash sync.
# Also syncs globally so any other server still works (may take up to an hour).
# Example: DISCORD_GUILD_ID=111111111111111111,222222222222222222
DISCORD_GUILD_ID=

# Optional. Enables /ask and answers when someone @mentions the bot.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SEC asks for a user agent that identifies you. Include an email.
SEC_USER_AGENT=market-desk/1.0 (you@example.com)

# Clock for reminders, the morning brief, and the close recap.
TZ=America/New_York
MORNING_HHMM=08:00
CLOSE_HHMM=16:15

# Optional. Posts TradingView (or any) webhooks into the channel you pick
# with /schedule webhook. Leave the port empty to keep the listener off.
WEBHOOK_PORT=
WEBHOOK_SECRET=

DATABASE_PATH=data/desk.db

# Live ticker pills (IB-style auto-refresh)
LIVE_PILL_INTERVAL_SEC=20
LIVE_PILL_TTL_SEC=720
LIVE_PILL_MAX=40
